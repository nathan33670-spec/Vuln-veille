# Vuln-Veille configuration. Copy with `make env` (generates random secrets) — never commit .env.

VV_ENVIRONMENT=dev
VV_LOG_LEVEL=INFO

# Public hostnames and TLS (deploy/caddy/Caddyfile).
VV_BACKOFFICE_HOST=backoffice.localhost
VV_PORTAL_HOST=portal.localhost
# "internal" = local CA (dev, intranet); an e-mail address = Let's Encrypt; or "/certs/cert.pem /certs/key.pem".
VV_TLS=internal
# Networks allowed to reach the back-office (space-separated CIDRs, or private_ranges).
VV_BACKOFFICE_ALLOWED_CIDRS=private_ranges
VV_HTTP_PORT=80
VV_HTTPS_PORT=443
VV_BACKOFFICE_ORIGIN=https://backoffice.localhost
VV_PORTAL_ORIGIN=https://portal.localhost

# PostgreSQL. The admin account is only used by the one-shot "migrate" service.
VV_DB_NAME=vuln_veille
VV_DB_ADMIN_USER=vv_admin
VV_DB_ADMIN_PASSWORD=
VV_DB_PASSWORD_MIGRATOR=
VV_DB_PASSWORD_APP=
VV_DB_PASSWORD_WORKER=
VV_DB_PASSWORD_PORTAL=

# Redis
VV_REDIS_PASSWORD=

# Application secrets (generated by `make env`; never reuse them across environments).
# HMAC key for CSRF tokens, one-time tokens and recovery codes.
VV_SECRET_KEY=
# AES-256-GCM key (base64, 32 bytes) encrypting TOTP secrets. Keep an offline backup:
# losing it forces every user to enrol MFA again.
VV_KEK_TOTP=

# Secret vault (ADR-013): public keys only. The matching private keyrings are created in
# secrets/keyrings/ and mounted as Docker secrets into the workers that need them.
# Rotation: scripts/vault-keygen.sh, then vault-rotate (docs/PROCEDURES.md §9).
VV_VAULT_PUBLIC_KEY_LLM=
VV_VAULT_PUBLIC_KEY_SOURCE=
VV_VAULT_PUBLIC_KEY_CONNECTOR=
VV_VAULT_PUBLIC_KEY_WEBHOOK=

# Outgoing e-mail (invitations, password resets). Dev: Mailpit (http://127.0.0.1:8025).
VV_SMTP_HOST=mailpit
VV_SMTP_PORT=1025
VV_SMTP_STARTTLS=false
VV_SMTP_USERNAME=
VV_SMTP_PASSWORD=
VV_SMTP_FROM=Vuln-Veille <no-reply@localhost>

  "info": {
    "title": "Vuln-Veille portal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/portal/v1/account/mfa": {
      "delete": {
        "description": "Clients only (MFA is optional for them, decision Q16), unless their org requires it.",
        "operationId": "disable_mfa_api_portal_v1_account_mfa_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Disable Mfa",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/portal/v1/account/mfa/recovery-codes": {
      "post": {
        "operationId": "regenerate_recovery_codes_api_portal_v1_account_mfa_recovery_codes_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodesOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Regenerate Recovery Codes",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/portal/v1/account/password": {
      "post": {
        "operationId": "change_password_api_portal_v1_account_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/portal/v1/account/sessions": {
      "get": {
        "operationId": "list_sessions_api_portal_v1_account_sessions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionOut"
                  },
                  "title": "Response List Sessions Api Portal V1 Account Sessions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/portal/v1/account/sessions/{session_id}": {
      "delete": {
        "operationId": "revoke_session_api_portal_v1_account_sessions__session_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
